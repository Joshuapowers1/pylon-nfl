# raw source data, re-fetchable with scripts/fetch_data.sh
data/raw/
data/processed/*.parquet

# python
__pycache__/
*.pyc
.venv/
venv/

# node
node_modules/
web/preview.html
# Screenshots and one-off probe scripts are working files, not source. They are
# regenerated by test.mjs and audit.mjs on demand.
web/shot-*.png
web/hero-*.png
web/logo-*.png
web/look*.png
web/mob-*.png
web/_*.mjs
web/_*.json

# os
.DS_Store

# fetched at build time by scripts/fetch_logos.py, not redistributed
data/logos/
web/logos-src/

# playwright is a dev-only test dependency, installed ad hoc
web/package.json
web/package-lock.json
